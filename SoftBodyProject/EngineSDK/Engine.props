  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <AdditionalIncludeDirectories>$(MDEngineSDKIncludeDirectories);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(MDEngineSDKLibraryDirectory);$(MDEngineSDKDependenciesRoot)プロジェクトに追加すべきファイル_VC用;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>MDEngine.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug' Or '$(Configuration)'=='Editor'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Editor'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;EDITOR;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MDEngineSDKRoot)Dependencies\imgui;$(MDEngineSDKRoot)Dependencies\ImGuizmo;$(MDEngineSDKRoot)Editor\Include;$(MDEngineSDKRoot)Editor\Include\Source;$(MDEngineSDKRoot)Editor\Include\Source\Command;$(MDEngineSDKRoot)Editor\Include\Source\Command\History;$(MDEngineSDKRoot)Editor\Include\Source\Document;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Base;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Body;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\CharacterController;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Collider;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Constraint;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Constraint\Base;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Constraint\Settings;$(MDEngineSDKRoot)Editor\Include\Source\Document\Component\Renderer;$(MDEngineSDKRoot)Editor\Include\Source\Document\Func;$(MDEngineSDKRoot)Editor\Include\Source\Document\Object;$(MDEngineSDKRoot)Editor\Include\Source\IO;$(MDEngineSDKRoot)Editor\Include\Source\Panel;$(MDEngineSDKRoot)Editor\Include\Source\Panel\Base;$(MDEngineSDKRoot)Editor\Include\Source\Panel\Tool;$(MDEngineSDKRoot)Editor\Include\Source\Panel\Tool\ModelLoader;$(MDEngineSDKRoot)Editor\Include\Source\UI;$(MDEngineSDKRoot)Editor\Include\Source\UI\Gizmo;$(MDEngineSDKRoot)Editor\Include\Source\UI\Setting;$(MDEngineSDKRoot)Editor\Include\Source\UI\Widgets;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Platform)' == 'x64'">
    <Link>
      <AdditionalDependencies>MDEditor.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ForceSymbolReferences>WinMain;%(ForceSymbolReferences)</ForceSymbolReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>